# CoBWeaverClaw — مثال متغيّرات البيئة (تُوضع في ~/.cobweaverclaw/.env)
# انسخ ما تحتاجه فقط. مفاتيح المزوّدين تُضاف عبر: python main.py setup

# ── طبقة ذكاء الويب (web_intelligence) — اختيارية ──
# ClawCrawl (Firecrawl) — بحث/زحف. مفتاح من firecrawl.dev، أو self-hosted.
# CLAW_CRAWL_API_KEY=fc-YOUR_KEY_HERE
# CLAW_CRAWL_BASE_URL=http://localhost:3002

# ClawBrowser (browser-use) — متصفح حقيقي. يمكن استخدام نفس مفتاح مزوّد الوكيل.
# LLM_API_KEY=sk-YOUR_KEY_HERE
